[Unit]
Description=Traefik (students.iima.ac.in gateway)
Wants=network-online.target
After=network-online.target

[Service]
User=traefik
Group=traefik
# Ports 80 and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# plugins-local/ is resolved from here.
WorkingDirectory=/etc/traefik
ExecStart=/usr/local/bin/traefik --configFile=/etc/traefik/traefik.yml
Environment=IIMA_CORE_URL=http://127.0.0.1:8081
Restart=always
RestartSec=2
LimitNOFILE=65536
ProtectSystem=strict
ReadWritePaths=/var/log/traefik /etc/traefik

[Install]
WantedBy=multi-user.target
